{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true
  },
  "include": ["src/controller/index.ts", "src/formatter/index.js"]
}
