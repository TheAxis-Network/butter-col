# Rendered by `butter-col server` into <runtime>/conf/butter-proxy.conf ({{CACERT}} = CA bundle path).
# Upstream settings shared by /butter/fetch and /butter/ws.
# The Lua access handler fills in the $butter_* variables after validating
# the target and resolving it to an address that passed the SSRF guard.

proxy_pass $butter_scheme://$butter_addr$butter_uri;
proxy_http_version 1.1;
proxy_set_header Host $butter_host;

proxy_ssl_server_name on;
proxy_ssl_name $butter_sni;
proxy_ssl_protocols TLSv1.2 TLSv1.3;
proxy_ssl_verify on;
proxy_ssl_verify_depth 5;
proxy_ssl_trusted_certificate {{CACERT}};
proxy_ssl_session_reuse on;

# Never let an upstream steer nginx (X-Accel-Redirect would be an internal redirect).
proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;

proxy_redirect off;
proxy_buffering off;
proxy_intercept_errors off;
proxy_connect_timeout 15s;

# Room for large upstream response headers (big CSPs, many cookies).
proxy_buffer_size 64k;
proxy_buffers 16 64k;
proxy_busy_buffers_size 128k;
